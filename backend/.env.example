# ========================================================
# Student Information Management System - Backend Environment
# ========================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace placeholders:
#   <username>    -> MongoDB Atlas Database Username
#   <password>    -> MongoDB Atlas Database User Password
#   <cluster-url> -> Your cluster hostname (e.g., cluster0.abcde.mongodb.net)
#   <database>    -> Database name (e.g., student_db)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Local MongoDB alternative for offline testing (optional):
# MONGODB_URI=mongodb://127.0.0.1:27017/student_db

# Allowed Frontend Origins for CORS (comma-separated list for local ports & production Vercel URL)
FRONTEND_URL=http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:5173
